{
  "name": "@mosbot-ai/dshpa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": ["lib", "locale", "prompts", "cordis.patch.yml"],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs"
  }
}
